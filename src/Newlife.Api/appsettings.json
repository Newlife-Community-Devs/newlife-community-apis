  "Email": {
    "Provider": "None",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "no-reply@nlcbcgh.com"
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "Administrator",
    "DemoData": false
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4080"
  },
