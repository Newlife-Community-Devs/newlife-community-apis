{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=newlife;Username=newlife;Password=newlife_dev"
  },
  "Database": {
    "RunMigrationsOnStartup": false
  },
  "JWT": {
    "Issuer": "newlife-community-apis",
    "Audience": "newlife-website",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "RefreshRotationGraceSeconds": 60
