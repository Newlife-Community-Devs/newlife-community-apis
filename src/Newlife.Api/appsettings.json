  "RateLimits": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4080", "http://localhost:3000" ],
    "AllowVercelPreviews": false
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "Hubtel": {
    "ApiId": "",
    "ApiKey": "",
    "MerchantAccountNumber": "",
    "CreateCheckoutUrl": "https://payproxyapi.hubtel.com/items/initiate",
    "StatusBaseUrl": "https://api-txnstatus.hubtel.com",
    "RefundBaseUrl": "https://refund-api.hubtel.com",
    "CallbackBaseUrl": "http://localhost:8080",
    "CallbackToken": "",
    "EnforceCallbackIp": true,
    "Sandbox": false
  },
  "Storage": {
    "Provider": "Local",
    "R2": {
      "AccountId": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "BucketName": "",
      "PublicBaseUrl": ""
    }
  },
  "Sermons": {
    "FeedUrl": "https://media.rss.com/the-newlife-podcast/feed.xml",
    "SyncIntervalMinutes": 60
