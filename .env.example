# Copy to .env (never commit) or set these in the Render dashboard.
# Render uses double-underscore nesting for appsettings keys.

ASPNETCORE_ENVIRONMENT=Development

# Database. Either form works; DATABASE_URL (Neon/managed-Postgres URI,
# e.g. postgresql://user:pass@host-pooler.../neondb?sslmode=require) is
# preferred automatically when ConnectionStrings__Default is unset.
# Locally, `neon init` writes DATABASE_URL into .env.local (gitignored, dev-only).
ConnectionStrings__Default=Host=localhost;Port=5433;Database=newlife;Username=newlife;Password=newlife_dev
# DATABASE_URL=
Database__RunMigrationsOnStartup=true

# Auth (signing key must be >= 64 random characters in production)
JWT__SigningKey=
JWT__Issuer=newlife-community-apis
JWT__Audience=newlife-website
JWT__AccessTokenMinutes=60
JWT__RefreshTokenDays=30
JWT__RefreshRotationGraceSeconds=60

# CORS (website origins)
Cors__AllowedOrigins__0=http://localhost:4080
Cors__AllowedOrigins__1=https://www.nlcbcgh.com

# Render terminates TLS; enable forwarded headers in production
ReverseProxy__Enabled=true

# Hubtel (Workbench -> API keys)
Hubtel__ApiId=
Hubtel__ApiKey=
Hubtel__MerchantAccountNumber=
Hubtel__CallbackBaseUrl=http://localhost:8080
Hubtel__CallbackToken=
Hubtel__EnforceCallbackIp=true
Hubtel__Sandbox=false

# Storage: Local (dev) or R2 (production)
Storage__Provider=Local
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=
Storage__R2__PublicBaseUrl=

# Sermons
Sermons__FeedUrl=https://media.rss.com/the-newlife-podcast/feed.xml
Sermons__SyncEnabled=true
Sermons__SyncIntervalMinutes=60

# Payment background jobs (defaults match production behaviour)
Payments__ReconciliationIntervalSeconds=60
Payments__ReconciliationMinAgeSeconds=300
Payments__ExpiryIntervalSeconds=300

# Email (optional)
Email__Provider=None
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromAddress=no-reply@nlcbcgh.com

# Seeding (first deploy only; clear AdminPassword afterwards)
Seed__AdminEmail=
Seed__AdminPassword=
Seed__AdminFullName=Administrator
Seed__DemoData=false
SEED_YOUTUBE_URL=

# Frontend
Frontend__BaseUrl=http://localhost:4080
